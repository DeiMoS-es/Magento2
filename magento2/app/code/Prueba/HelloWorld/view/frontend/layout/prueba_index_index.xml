<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
      layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.main.title">
           <action method="setPageTitle">
               <argument translate="true" name="title" xsi:type="string">
                 Hola Mundo desde Prueba_HelloWorld
               </argument>
           </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block name="prueba_helloworld.index"
                   template="Prueba_HelloWorld::index.phtml">
                   <arguments>
                       <argument name="TwitchViewModel" xsi:type="object">Prueba\HelloWorld\ViewModel\Twitch</argument>
                   </arguments>
            </block>
        </referenceContainer>
    </body>
</page>